+static int ksceIftuSetInputFrameBufferPatched(int plane, SceIftuPlaneState *state, int bilinear, int sync_mode) {
+  /*
+   * At the default 960x544 output, IFTU point sampling produces the same
+   * exact 2x pixel replication as Sharp Bilinear Simple.  Keeping the PSP
+   * framebuffer in this direct path avoids the user-mode GXM display queue.
+   */
+  if (pspemu_direct_sharp_scale && bilinear == 1 && state &&
+      state->fb.width == 480 && state->fb.height == 272) {
+    bilinear = 0;
+  }
+
+  return TAI_CONTINUE(int, ksceIftuSetInputFrameBufferRef,
+                      plane, state, bilinear, sync_mode);
+}
+
+int kuSetPspemuDirectSharpScale(int enabled) {
+  if (ksceIftuSetInputFrameBufferHook < 0) {
+    pspemu_direct_sharp_scale = 0;
+    return ksceIftuSetInputFrameBufferHook;
+  }
+
+  pspemu_direct_sharp_scale = enabled != 0;
+  __sync_synchronize();
+  return 0;
+}
+
 static SceUID ksceKernelAllocMemBlockPatched(const char *name, SceKernelMemBlockType type, int size, SceKernelAllocMemBlockKernelOpt *optp) {
   SceUID blockid = TAI_CONTINUE(SceUID, ksceKernelAllocMemBlockRef, name, type, size, optp);
 
